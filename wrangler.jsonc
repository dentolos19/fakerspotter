{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fakerspotter",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-10-01",
  "observability": {
    "logs": {
      "enabled": true,
    },
    "traces": {
      "enabled": true,
    },
    "issues": {
      "enabled": true,
    },
  },
  "routes": [
    {
      "pattern": "fakerspotter.dennise.me",
      "custom_domain": true,
    },
  ],
}
